  }

  if (
    queue === 'payout'
  ) {
    return [
      'businessDisplayName',
      'legalName',
      'bankCountry',
      'payoutCurrency',
      'bankName',
      'accountHolderName',
      'accountNumber',
      'reviewerNotes',
    ];
  }

  if (
    queue === 'reverification'
  ) {
    return [
      'businessDisplayName',
      'legalName',
      'country',
      'reverificationReason',
      'documentKind',
      'dueAt',
      'reviewerNotes',
    ];
  }

  if (
    queue === 'user_reports'
  ) {
    return [
      'reportedName',
      'reporterName',
      'reason',
      'details',
      'accountReportCount',
      'moderationStatus',
    ];
